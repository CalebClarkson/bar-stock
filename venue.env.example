# Copy to venue.env (gitignored). Never commit real values.
# Listen address. 127.0.0.1 = this PC only. Use 0.0.0.0 to serve staff devices.
OSB_BIND=127.0.0.1
# Set to 1 only when served over HTTPS (e.g. tailscale serve).
OSB_HTTPS=0
# Optional live Square sync. Leave blank to use the end-of-day CSV import.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_POLL_MINUTES=5
# Optional invoice photo reading. Provider: claude or openai.
AI_PROVIDER=claude
AI_API_KEY=
